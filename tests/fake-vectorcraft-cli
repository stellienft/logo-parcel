#!/usr/bin/env python3
"""Stand-in for vectorcraft-cli in tests: answers the commands Logo Parcel sends with plausible results and real PNGs."""
import json, sys, struct, zlib, shutil, os
from pathlib import Path
args=sys.argv[1:]; assert args[0]=='run' and args[1]=='--in'
src=args[2]; cmds=[]; i=3
while i<len(args): cmds.append((args[i+1],json.loads(args[i+3]))); i+=4
log=os.environ.get('STUB_LOG')
if log:
    with open(log,'a') as f: f.write(json.dumps([src,[c for c,_ in cmds]])+'\n')
board={'x':0,'y':0,'width':200,'height':100}
def png(w,h,rgba=(232,89,63,255)):
    raw=b''.join(b'\0'+bytes(rgba)*w for _ in range(h))
    chunk=lambda t,d: struct.pack('>I',len(d))+t+d+struct.pack('>I',zlib.crc32(t+d)&0xffffffff)
    return b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack('>IIBBBBB',w,h,8,6,0,0,0))+chunk(b'IDAT',zlib.compress(raw))+chunk(b'IEND',b'')
for cmd,p in cmds:
    r={}
    if cmd=='document.inspect': r={'artboards':[dict(board)],'layers':[{'locked':False,'children':[]}],'warnings':[]}
    elif cmd=='document.info': r={'document':{'artboards':[{'name':'Main'},{'name':'Alt'}]},'fonts':['Inter Bold'],'images':{'k1':{'width':300,'height':200,'linked':False}}}
    elif cmd=='document.exportForScreens':
        out=Path(p['folder'])/'iso.vectorcraft'; out.write_text('doc'); r={'files':[str(out)],'warnings':[]}
    elif cmd=='artboard.setProps': board.update({k:p[k] for k in ('x','y','width','height') if k in p})
    elif cmd=='artboard.fitToArt': board={'x':0,'y':0,'width':200,'height':100}
    elif cmd=='recolor.colors': r={'colors':[{'key':'rgb 232 89 63','hex':'#e8593f','count':9},{'key':'rgb 16 16 18','hex':'#101012','count':3},{'key':'gray 50','hex':'#808080','count':1}]}
    elif cmd=='color.convert': r={'model':'cmyk','values':[0.0,0.72,0.8,0.02],'hex':'#000000'}
    elif cmd=='edit.colorSettings': r={'rgb':'sRGB','cmyk':p.get('cmyk','VectorCraft Generic CMYK (SWOP-like)'),'profiles':[{'name':'VectorCraft Generic CMYK (SWOP-like)','kind':'cmyk','builtin':True}]}
    elif cmd=='color.loadProfile': r={'name':'Coated FOGRA39 (test)','kind':'cmyk','remembered':True}
    elif cmd=='document.export':
        s=p.get('scale',1); w=max(1,round(board['width']*s)); h=max(1,round(board['height']*s))
        data=png(min(w,600),min(h,600)) if p['format'] in ('png','jpg') else b'%PDF stub'
        if p['format']=='png' and w<=4096: data=png(w,h)
        Path(p['path']).write_bytes(data); r={'files':[p['path']],'warnings':[],'size':[w,h]}
    print(json.dumps({'command':cmd,'result':r}))
